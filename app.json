{
  "expo": {
    "name": "Tastizo Partner",
    "slug": "Tastizo partner",
    "version": "0.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/iconv2_transparent.png",
    "scheme": "tastizo-partner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tastizo.restaurantpartner"
    },
    "android": {
      "versionCode": 3,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#299861",
        "foregroundImage": "./assets/images/iconv2_padded_transparent.png"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.tastizo.restaurantpartner",
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon_transparent.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#299861",
          "dark": {
            "backgroundColor": "#299861"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}