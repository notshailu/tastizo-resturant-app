{
  "expo": {
    "name": "Tastizo Delivery",
    "slug": "Tastizo delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iconv2_padded_transparent.png",
    "scheme": "tastizo-delivery",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tastizo.deliverypartner"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon_padded_transparent.png"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.tastizo.deliverypartner",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Tastizo Delivery to use your location for tracking deliveries.",
          "locationAlwaysPermission": "Allow Tastizo Delivery to track your location in the background for delivery assignments.",
          "locationWhenInUsePermission": "Allow Tastizo Delivery to use your location to find nearby orders.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "@react-native-firebase/app",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/image.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}